# Kopiera till .env och fyll i. .env checkas inte in.

# Nodens nummer i topology.json (1-255). Olika för varje kort du programmerar.
NODE_ID=6

# Wi-Fi-kanal för ESP-NOW (1-13). SAMMA på alla noder.
ESPNOW_CHANNEL=1

# Gruppnyckel, 32 hex-tecken. SAMMA på alla noder. Skapa med:
#   python3 -c "import secrets; print(secrets.token_hex(16))"
GROUP_KEY=CHANGE_ME
